# Normalize line endings to LF for all text files.
# Prevents spurious CRLF diffs when checking out on Windows (GitHub Desktop).
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.mp4  binary
*.webm binary
*.svg  text eol=lf
