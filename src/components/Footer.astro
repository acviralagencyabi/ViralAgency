---
import { Image } from 'astro:assets';
import globalSettings from '../../content/settings/global.json';
import homepage from '../../content/pages/homepage.json';
import { Instagram, Facebook } from 'lucide-astro';
import logoFullDefault from '../assets/images/brand/logo-black-tagline.png';

const brandImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/brand/**/*.{png,jpg,jpeg,gif,webp,svg}',
  { eager: true }
);

const logoFull =
  (globalSettings.logoFooter && brandImages[globalSettings.logoFooter]?.default) ||
  logoFullDefault;

const currentYear = new Date().getFullYear();
const email = globalSettings.contact?.email || 'info@viralagency.it';
const locations = (homepage as any).locations ?? [];

const mapsUrl = (loc: { city?: string; address?: string }) => {
  const q = [loc.address, loc.city].filter(Boolean).join(', ');
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
};
---

<footer class="section-dark mt-0">
  <div class="container-custom py-16 md:py-24">
    <!-- Huge mailto -->
    <div class="mb-16 md:mb-24 reveal">
      <p class="eyebrow text-white/60">Parliamone</p>
      <a
        href={`mailto:${email}`}
        class="block h-display text-[clamp(2.5rem,9vw,7rem)] text-[var(--paper)] hover:text-[var(--electric)] transition-colors duration-500 leading-[0.9] mt-4 break-all"
        data-cursor="scrivici"
      >
        {email}
        <span class="inline-block align-top text-[var(--electric)] ml-3 text-[0.6em]">↗</span>
      </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-8">
      <!-- Brand -->
      <div class="col-span-2">
        <p class="mono-label text-white/60 mb-3">Brand</p>
        <Image src={logoFull} alt={globalSettings.companyName} width={320} height={140} class="h-20 w-auto img-darken" />
        <p class="mono-label text-white/40 mt-4">
          {globalSettings.companyName} — Communication · Marketing · Social · Branding
        </p>
      </div>

      <!-- Contatti -->
      <div>
        <p class="mono-label text-white/60 mb-3">Contatti</p>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href={`mailto:${email}`} class="hover:text-[var(--electric)] transition-colors">{email}</a></li>
          {globalSettings.contact?.phone && (
            <li><a href={`tel:${globalSettings.contact.phone.replace(/\s/g, '')}`} class="hover:text-[var(--electric)] transition-colors">{globalSettings.contact.phone}</a></li>
          )}
        </ul>

        {locations.length > 0 && (
          <>
            <p class="mono-label text-white/60 mt-6 mb-3">Sedi</p>
            <ul class="space-y-3 text-sm text-white/80">
              {locations.map((loc: any) => (
                <li>
                  {loc.address ? (
                    <a
                      href={mapsUrl(loc)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group block hover:text-[var(--electric)] transition-colors"
                      data-cursor="apri mappa"
                      aria-label={`Apri ${loc.city ?? loc.address} su Google Maps`}
                    >
                      <span class="block text-[var(--paper)] group-hover:text-[var(--electric)] transition-colors">
                        {loc.city}{loc.tag && <span class="text-white/40"> — {loc.tag}</span>}
                      </span>
                      <span class="block text-white/60 group-hover:text-[var(--electric)] transition-colors">{loc.address}</span>
                    </a>
                  ) : (
                    <span class="block text-[var(--paper)]">
                      {loc.city}{loc.tag && <span class="text-white/40"> — {loc.tag}</span>}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>

      <!-- Legale + social -->
      <div>
        <p class="mono-label text-white/60 mb-3">Legale</p>
        <ul class="space-y-2 text-sm text-white/60">
          {globalSettings.legal?.piva && <li>P.IVA {globalSettings.legal.piva}</li>}
          {globalSettings.legal?.codiceDestinatario && <li>SDI {globalSettings.legal.codiceDestinatario}</li>}
        </ul>

        <p class="mono-label text-white/60 mt-6 mb-3">Seguici</p>
        <div class="flex gap-2">
          {globalSettings.social?.instagram && (
            <a href={globalSettings.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full border border-white/30 grid place-items-center hover:bg-[var(--electric)] hover:border-[var(--electric)] transition-colors">
              <Instagram class="w-4 h-4" strokeWidth={1.5} />
            </a>
          )}
          {globalSettings.social?.facebook && (
            <a href={globalSettings.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-full border border-white/30 grid place-items-center hover:bg-[var(--electric)] hover:border-[var(--electric)] transition-colors">
              <Facebook class="w-4 h-4" strokeWidth={1.5} />
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 flex flex-wrap gap-4 items-center justify-between mono-label text-white/50">
      <span>© {currentYear} {globalSettings.companyName} — Tutti i diritti riservati</span>
      <span>Site design — REAL GOES VIRAL · {currentYear}</span>
    </div>
  </div>
</footer>
