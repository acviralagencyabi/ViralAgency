---
import Layout from '../layouts/Layout.astro';
import globalSettings from '../../content/settings/global.json';
const email = globalSettings.contact?.email || 'info@viralagency.it';
const phone = globalSettings.contact?.phone || '+39 371 376 7488';
const BASE = import.meta.env.BASE_URL;
const services = [
  { title: 'Logo & Identità Visiva', desc: 'Progettiamo loghi che funzionano su qualsiasi superficie: digitale, stampa, packaging, segnaletica.' },
  { title: 'Brand Book', desc: "Manuale d'uso del tuo brand: colori, tipografie, immagini, tono di voce e regole d'uso per tutti i canali." },
  { title: 'Sistema Grafico', desc: "Template, iconografia, pattern e elementi grafici coerenti che rendono il tuo brand riconoscibile a colpo d'occhio." },
  { title: 'Packaging Design', desc: "Confezioni, etichette e packaging per i prodotti delle aziende modenesi. Dal cibo al lusso, dall'industria all'artigianato." },
  { title: 'Materiali di Stampa', desc: 'Biglietti da visita, brochure, cataloghi, cartoline e materiali promozionali per fiere ed eventi locali.' },
  { title: 'Rebranding', desc: "Se il tuo brand è cresciuto ma l'immagine è rimasta indietro, ti aiutiamo a rinnovare senza perdere riconoscibilità." },
];
const schema = JSON.stringify({
  "@context":"https://schema.org","@graph":[
    {"@type":"LocalBusiness","@id":"https://viralagency.it/#business","name":"Viral Digital Agency | Agenzia di Marketing","url":"https://viralagency.it","telephone":"+393713767488","email":"info@viralagency.it","hasMap":"https://maps.google.com/?kgmid=/g/11m75qc3vq","address":[{"@type":"PostalAddress","streetAddress":"Piazza Tintori 27","addressLocality":"Bastiglia","addressRegion":"MO","postalCode":"41033","addressCountry":"IT"},{"@type":"PostalAddress","streetAddress":"V.le Pietro Pietramellara, 33","addressLocality":"Bologna","addressRegion":"BO","postalCode":"40121","addressCountry":"IT"}],"areaServed":["Modena","Emilia-Romagna"],"priceRange":"€€"},
    {"@type":"Service","name":"Branding e Identità Visiva Modena","serviceType":"Brand Design","provider":{"@id":"https://viralagency.it/#business"},"areaServed":"Modena","description":"Branding, logo design, identità visiva e brand book per aziende di Modena. Costruiamo brand memorabili per il mercato locale e nazionale."}
  ]
});
---
<Layout title="Agenzia di Branding Modena | Viral Digital Agency" description="Branding, identità visiva e logo design a Modena. Viral Digital Agency costruisce brand memorabili per aziende modenesi che vogliono distinguersi. Studio a Bastiglia (MO).">
  <div class="pt-28 md:pt-40">
    <section class="section">
      <div class="container-custom">
        <p class="eyebrow reveal">Branding · Modena</p>
        <h1 class="h-display text-[clamp(2.5rem,6.5vw,5.5rem)] leading-[0.92] mt-3 max-w-4xl reveal">
          Agenzia di Branding<br />a <em class="not-italic text-[var(--electric)]">Modena</em>
        </h1>
        <p class="text-[1.125rem] text-[var(--muted)] max-w-2xl mt-6 leading-relaxed reveal">
          Le aziende di Modena sanno fare prodotti eccezionali. Noi le aiutiamo a sembrare eccezionali tanto quanto lo sono. Costruiamo identità visive che resistono al tempo, funzionano su tutti i canali e si differenziano nella piazza modenese.
        </p>
        <div class="flex flex-wrap gap-4 mt-10 reveal">
          <a href={`${BASE}#contatti`} class="btn-primary magnetic-btn" data-cursor="parliamo">Costruiamo il tuo brand</a>
          <a href={`tel:${phone.replace(/\s/g,'')}`} class="btn-outline">{phone}</a>
        </div>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container-custom">
        <p class="eyebrow reveal">Servizi di Branding</p>
        <h2 class="section-title mt-3 max-w-3xl">Tutto quello che serve per costruire un brand solido a Modena.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-12">
          {services.map((s) => (
            <div class="reveal border border-white/10 p-6 rounded-sm hover:border-[var(--electric)] transition-colors">
              <h3 class="font-semibold text-[var(--paper)] mb-2">{s.title}</h3>
              <p class="text-sm text-white/70 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container-custom">
        <p class="eyebrow reveal">Il nostro processo</p>
        <h2 class="section-title mt-3 max-w-3xl">Un brand modenese deve raccontare eccellenza. Noi ci riusciamo.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 max-w-4xl">
          <p class="text-[var(--muted)] leading-relaxed reveal">L'Emilia-Romagna, e Modena in particolare, è sinonimo di qualità nel mondo. Automotive, gastronomia, manifattura, moda: i brand modenesi competono a livello internazionale. Un'identità visiva sciatta o datata penalizza anche il prodotto migliore. Noi costruiamo immagini all'altezza dell'eccellenza modenese.</p>
          <p class="text-[var(--muted)] leading-relaxed reveal">Il nostro processo di branding parte sempre dall'ascolto: capire la storia dell'azienda, i valori che la animano, il mercato in cui opera e le persone a cui si rivolge. Solo dopo iniziamo a disegnare. Il risultato è un brand che rispecchia l'azienda reale, non una versione patinata e generica.</p>
        </div>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container-custom">
        <p class="eyebrow reveal">Dove siamo</p>
        <h2 class="section-title mt-3">Studio di design a Modena. Clienti in tutta Italia.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
          <div class="reveal">
            <p class="mono-label text-white/60 mb-4">Studio Creativo — Modena</p>
            <address class="not-italic space-y-1 text-[var(--paper)]">
              <strong class="block text-lg">Viral Digital Agency</strong>
              <span class="block text-white/80">Piazza Tintori 27</span>
              <span class="block text-white/80">Bastiglia (MO) – 41033</span>
              <a href={`tel:${phone.replace(/\s/g,'')}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors mt-4">{phone}</a>
              <a href={`mailto:${email}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors">{email}</a>
            </address>
            <a href="https://maps.google.com/?kgmid=/g/11m75qc3vq" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-5 text-sm text-[var(--electric)] hover:underline">Vedi su Google Maps ↗</a>
          </div>
          <div class="reveal">
            <p class="mono-label text-white/60 mb-4">Sede HQ — Bologna</p>
            <address class="not-italic space-y-1 text-[var(--paper)]">
              <strong class="block text-lg">Viral Digital Agency — HQ</strong>
              <span class="block text-white/80">V.le Pietro Pietramellara, 33</span>
              <span class="block text-white/80">40121 Bologna BO</span>
              <a href={`tel:${phone.replace(/\s/g,'')}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors mt-4">{phone}</a>
              <a href={`mailto:${email}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors">{email}</a>
            </address>
          </div>
        </div>
      </div>
    </section>
    <section class="section cta-section noise-overlay">
      <div class="container-custom text-center">
        <p class="eyebrow reveal">Inizia il percorso</p>
        <h2 class="section-title mt-3 max-w-2xl mx-auto">Il tuo brand modenese merita un'identità visiva al suo livello.</h2>
        <p class="text-[var(--paper)]/80 max-w-xl mx-auto mt-4 leading-relaxed reveal">Parliamo della tua azienda. In 30 minuti capiamo insieme dove si può fare la differenza.</p>
        <div class="flex flex-wrap gap-4 justify-center mt-8 reveal">
          <a href={`${BASE}#contatti`} class="btn-primary magnetic-btn">Parliamo di branding</a>
          <a href={`mailto:${email}`} class="btn-outline">{email}</a>
        </div>
      </div>
    </section>
  </div>
  <script is:inline type="application/ld+json" set:html={schema} />
</Layout>
