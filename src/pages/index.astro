---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { ArrowDown, Instagram, Facebook, Phone, Mail } from 'lucide-astro';

import homepage from '../../content/pages/homepage.json';
import globalSettings from '../../content/settings/global.json';

// Portfolio JSON
const portfolioFiles = import.meta.glob<{ default: any }>(
  '/content/portfolio/*.json',
  { eager: true }
);

// Portfolio images (optimized)
const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/**/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
);

// Team photos (optional, optimized)
const teamImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/team/**/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
);

const portfolio = Object.entries(portfolioFiles)
  .map(([filePath, mod]) => {
    const slug = filePath.split('/').pop()?.replace('.json', '') || '';
    const titleData = mod.default.title;
    const displayTitle = typeof titleData === 'object' ? titleData.name : titleData;
    const imagePath = mod.default.image;
    const imageModule = imagePath ? portfolioImages[imagePath] : null;
    return {
      ...mod.default,
      slug,
      displayTitle,
      image: imageModule?.default || null,
    };
  })
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

// ---------- Homepage content (tutto editabile via Keystatic) ----------
const H: any = homepage;
const manifesto = H.manifesto;
const servicesList = H.servicesList ?? [];
const clients: string[] = H.clients ?? [];
const locations = H.locations ?? [];
const reviews = H.reviews ?? [];

// Team con foto opzionale
const team = (H.team ?? []).map((m: any) => {
  const photoModule = m.photo ? teamImages[m.photo] : null;
  return {
    ...m,
    photo: photoModule?.default ?? null,
  };
});

// ---------- Articoli dalla collection Keystatic ----------
const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const allArticles = await getCollection('articles');
const articles = allArticles
  .filter((a) => a.data.featured !== false)
  .sort((a, b) => {
    const ord = (a.data.order ?? 999) - (b.data.order ?? 999);
    if (ord !== 0) return ord;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3)
  .map((a) => ({
    tag: a.data.tag,
    title: a.data.title,
    date: dateFormatter.format(a.data.date),
    href: `articoli/${a.id}`,
  }));

// Resolve internal links so they respect Astro's base path (e.g. /VisualDigitalAgencyDemo/ on GH Pages)
const BASE = import.meta.env.BASE_URL;
const link = (path: string) => {
  if (!path) return BASE;
  if (path.startsWith('http://') || path.startsWith('https://') || path.startsWith('mailto:') || path.startsWith('tel:')) return path;
  if (path.startsWith('#')) return path; // in-page anchors stay scope-local
  return BASE + path.replace(/^\//, '');
};

// Category tag helper for portfolio cards
function categoryFor(slug: string): string {
  if (slug.includes('vfdc')) return 'Branding';
  const n = parseInt(slug.replace(/\D/g, ''), 10) || 0;
  const cats = ['Social', 'Video', 'Campaign', 'Branding', 'Content', 'Shoot'];
  return cats[n % cats.length];
}
---

<Layout title={homepage.seo.title} description={homepage.seo.description}>

  <!-- =======================================================================
       HERO — minimale
       ======================================================================= -->
  <section id="home" class="min-h-screen flex flex-col justify-between pt-28 pb-10 md:pt-36">
    <div class="container-custom flex-1 flex flex-col">
      <!-- Top meta row -->
      <div class="flex flex-wrap items-start justify-between gap-4 mb-auto">
        <p class="mono-label text-[var(--muted)]">
          01 / HOMEPAGE
        </p>
        <p class="mono-label text-[var(--muted)] hidden md:block text-right">
          BOLOGNA · MODENA — IT<br />MOTOR VALLEY
        </p>
      </div>

      <!-- Main statement: gigantic title, nothing else -->
      <div class="my-auto py-10 md:py-16">
        <h1 class="h-display text-[clamp(3rem,13vw,11rem)] leading-[0.9]">
          <span class="line-reveal block"><span>REAL</span></span>
          <span class="line-reveal block" style="--line-delay: 0.1s"><span>GOES</span></span>
          <span class="line-reveal block" style="--line-delay: 0.2s">
            <span>VIRAL<span class="inline-block align-top text-[var(--electric)]">.</span></span>
          </span>
        </h1>
      </div>

      <!-- Bottom row: tagline + single CTA + scroll hint -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-end mt-auto">
        <p class="md:col-span-5 quote-big text-[var(--ink)]">
          Agenzia di comunicazione &amp; marketing.
        </p>
        <div class="md:col-span-4">
          <a href="#contatti" class="btn-primary magnetic-btn" data-cursor="prenota">
            Prenota una Call <span class="btn-arrow">↗</span>
          </a>
        </div>
        <a href="#manifesto" class="md:col-span-3 flex items-center justify-start md:justify-end gap-3 text-[var(--muted)] hover:text-[var(--ink)] transition-colors" aria-label="Scorri per esplorare">
          <span class="mono-label">Scroll</span>
          <ArrowDown class="w-4 h-4 animate-bounce" />
        </a>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee section-dark">
    <div class="marquee-track">
      <span>
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
      </span>
      <span aria-hidden="true">
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
        REAL GOES VIRAL <span class="dot"></span>
      </span>
    </div>
  </div>

  <!-- =======================================================================
       MANIFESTO / ABOUT
       ======================================================================= -->
  <section id="manifesto" class="section">
    <div class="container-custom grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-4 reveal-left">
        <p class="eyebrow">{manifesto.eyebrow}</p>
      </div>

      <div class="lg:col-span-8 reveal">
        <h2 class="section-title whitespace-pre-line">
          {manifesto.title}
        </h2>
        <p class="quote-big mt-8 text-[var(--muted)] max-w-2xl">
          {manifesto.body}
        </p>

        {manifesto.tagline && (
          <p class="mt-8 inline-flex items-start gap-3 max-w-2xl">
            <span class="mono-label text-[var(--electric)] mt-2 shrink-0">— MOTOR VALLEY</span>
            <span class="quote-big text-[var(--ink)]">{manifesto.tagline}</span>
          </p>
        )}

        <!-- KPIs -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-14 stagger-children">
          {manifesto.kpis.map((k: any) => (
            <div class="kpi">
              <span class="num mono-num" data-counter={k.num} data-suffix={k.suffix}>0{k.suffix}</span>
              <span class="label">{k.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       CLIENTI
       ======================================================================= -->
  <section id="clienti" class="section-tight section-divider">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
        <div class="reveal-left">
          <p class="eyebrow">— Clienti</p>
          <h2 class="section-title mt-3 max-w-2xl text-[clamp(1.6rem,3.5vw,2.8rem)]">Brand che ci hanno scelto.</h2>
        </div>
        <p class="mono-label text-[var(--muted)] max-w-xs">
          Una selezione di chi ha visto crescere i propri numeri lavorando con noi.
        </p>
      </div>

      <ul class="clients-grid stagger-children">
        {clients.map((name: string) => (
          <li>
            <a href="#contatti" class="client-cell" data-cursor="prossimo">
              <span class="client-name">{name}</span>
              <span class="client-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =======================================================================
       PORTFOLIO
       ======================================================================= -->
  <section id="portfolio" class="section section-dark">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <p class="eyebrow">02 — Portfolio</p>
          <h2 class="section-title mt-4 max-w-3xl">
            I lavori migliori,<br />cliente per cliente.
          </h2>
        </div>
        <a href="#contatti" class="btn-outline" data-cursor="scrivici">
          Il tuo prossimo <span class="btn-arrow">↗</span>
        </a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 stagger-children" id="portfolio-grid">
        {portfolio.map((item, index) => (
          <button
            type="button"
            class="portfolio-card text-left !aspect-[4/5]"
            data-index={index}
            data-cursor="apri"
            aria-label={`Apri ${item.description || item.displayTitle}`}
          >
            {item.image ? (
              <Image
                src={item.image}
                alt={item.description || item.displayTitle}
                class="w-full h-full object-cover"
                loading="lazy"
                width={600}
                height={750}
              />
            ) : (
              <div class="w-full h-full bg-[var(--ink-soft)] flex items-center justify-center">
                <span class="mono-label text-white/40">no image</span>
              </div>
            )}
            <div class="meta">
              <div>
                <span class="tag">{categoryFor(item.slug)}</span>
                <span class="title block mt-1">{item.description || item.displayTitle}</span>
              </div>
              <span class="tag">↗</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="lightbox-overlay"></div>
    <button type="button" class="lightbox-close" aria-label="Chiudi">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label="Immagine precedente">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button type="button" class="lightbox-nav lightbox-next" aria-label="Immagine successiva">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-image" src="" alt="" class="lightbox-image" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
    <div class="lightbox-counter">
      <span id="lightbox-current">1</span> / <span id="lightbox-total">1</span>
    </div>
  </div>

  <script is:inline define:vars={{ portfolioData: portfolio.map((p) => ({ image: p.image?.src || '', title: p.description || p.displayTitle })) }}>
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCurrent = document.getElementById('lightbox-current');
    const lightboxTotal = document.getElementById('lightbox-total');
    const portfolioItems = document.querySelectorAll('#portfolio-grid .portfolio-card');

    let currentIndex = 0;
    const images = portfolioData;

    function openLightbox(index) {
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    function updateLightbox() {
      const item = images[currentIndex];
      lightboxImage.src = item.image;
      lightboxImage.alt = item.title;
      lightboxCaption.textContent = item.title;
      lightboxCurrent.textContent = currentIndex + 1;
      lightboxTotal.textContent = images.length;
    }
    function nextImage() {
      currentIndex = (currentIndex + 1) % images.length;
      updateLightbox();
    }
    function prevImage() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateLightbox();
    }

    portfolioItems.forEach((item) => {
      item.addEventListener('click', () => {
        const index = parseInt(item.dataset.index, 10);
        openLightbox(index);
      });
    });
    document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
    document.querySelector('.lightbox-overlay').addEventListener('click', closeLightbox);
    document.querySelector('.lightbox-next').addEventListener('click', nextImage);
    document.querySelector('.lightbox-prev').addEventListener('click', prevImage);

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });

    let touchStartX = 0;
    let touchEndX = 0;
    lightbox.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) { if (diff > 0) nextImage(); else prevImage(); }
    }, { passive: true });
  </script>

  <!-- =======================================================================
       SERVIZI
       ======================================================================= -->
  <section id="servizi" class="section">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12">
        <div class="lg:col-span-5 reveal-left">
          <p class="eyebrow">03 — Servizi</p>
          <h2 class="section-title mt-4">Quello che facciamo, ogni giorno.</h2>
        </div>
        <div class="lg:col-span-7 reveal lg:pt-20">
          <p class="quote-big text-[var(--muted)]">
            Un reparto marketing esterno, completo. Strategia, contenuti, performance.
            Nessun pacchetto preconfezionato: solo quello che serve al tuo brand.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-[var(--hairline)] stagger-children">
        {servicesList.map((s: any) => (
          <a href="#contatti" class="service-card" data-cursor="richiedi">
            <div class="flex items-baseline justify-between gap-4">
              <span class="mono-label text-[var(--muted)]">{s.num}</span>
              <span class="sv-arrow mono" aria-hidden="true">↗</span>
            </div>
            <h3 class="sv-title mt-4">{s.title}</h3>
            <p class="text-[var(--muted)] mt-3 max-w-md">{s.desc}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="sv-bullets mt-6">
                {s.bullets.map((b: string) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       TEAM
       ======================================================================= -->
  <section id="team" class="section section-dark">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <p class="eyebrow">04 — Team</p>
          <h2 class="section-title mt-4 max-w-3xl">
            Persone vere dietro ogni post.
          </h2>
        </div>
        <p class="mono-label text-white/60 max-w-xs">
          Un team piccolo, selezionato, ossessionato dal risultato.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 stagger-children">
        {team.map((m: any) => (
          <div class="portfolio-card !aspect-[3/4] bg-[var(--ink-soft)]">
            {m.photo ? (
              <Image
                src={m.photo}
                alt={m.name}
                width={500}
                height={667}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="h-display text-[clamp(3rem,10vw,6rem)] text-white/20 select-none">{m.initials}</span>
              </div>
            )}
            <div class="meta" style="transform: translateY(0); opacity: 1;">
              <div>
                <span class="tag">{m.role}</span>
                <span class="title block mt-1">{m.name}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       RECENSIONI
       ======================================================================= -->
  <section id="recensioni" class="section">
    <div class="container-custom">
      <div class="mb-12 reveal-left">
        <p class="eyebrow">05 — Recensioni</p>
        <h2 class="section-title mt-4 max-w-3xl">Lo dicono i nostri clienti.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-b border-[var(--hairline)] stagger-children">
        {reviews.map((r: any) => (
          <div class="feature-card border-0 md:border-r md:border-[var(--hairline)] last:md:border-r-0 h-full flex flex-col justify-between gap-8 min-h-[280px]">
            <p class="quote-big">"{r.quote}"</p>
            <div>
              <p class="mono-label text-[var(--ink)]">{r.author}</p>
              <p class="mono-label text-[var(--muted)] mt-1">{r.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       ARTICOLI
       ======================================================================= -->
  <section id="articoli" class="section">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <p class="eyebrow">06 — Articoli</p>
          <h2 class="section-title mt-4 max-w-3xl">Interviste &amp; approfondimenti.</h2>
        </div>
        <a href="#contatti" class="btn-outline" data-cursor="scrivici">
          Suggeriscine uno <span class="btn-arrow">↗</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        {articles.map((a: any) => (
          <a href={link(a.href || 'articoli')} class="feature-card group block" data-cursor="leggi">
            <p class="mono-label text-[var(--electric)] mb-6">{a.tag}</p>
            <h3 class="text-2xl md:text-3xl leading-tight mb-8">{a.title}</h3>
            <div class="flex items-center justify-between border-t border-[var(--hairline)] pt-4">
              <span class="mono-label text-[var(--muted)]">{a.date}</span>
              <span class="mono-label">Leggi ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       SOCIAL (compact)
       ======================================================================= -->
  <section id="social" class="section-tight">
    <div class="container-custom">
      <div class="flex flex-wrap items-center justify-between gap-6 border-y border-[var(--hairline)] py-8">
        <div>
          <p class="eyebrow">Seguici</p>
          <p class="h-display text-2xl md:text-3xl mt-2">{H.social?.title || 'Restiamo connessi'}</p>
        </div>
        <div class="flex items-center gap-3">
          {globalSettings.social?.instagram && (
            <a
              href={globalSettings.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
              data-cursor="instagram"
              aria-label="Instagram"
            >
              <Instagram class="w-4 h-4" strokeWidth={1.5} /> Instagram
            </a>
          )}
          {globalSettings.social?.facebook && (
            <a
              href={globalSettings.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
              data-cursor="facebook"
              aria-label="Facebook"
            >
              <Facebook class="w-4 h-4" strokeWidth={1.5} /> Facebook
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       CONTATTI — bianco su blu
       ======================================================================= -->
  <section id="contatti" class="section cta-section noise-overlay">
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-6 reveal-left">
          <p class="eyebrow text-white/70">07 — Contatti</p>
          <h2 class="section-title mt-4 text-[var(--paper)]">
            Prenota una call.
          </h2>
          <p class="quote-big mt-6 text-white/85 max-w-xl">
            {H.contact?.description || 'Raccontaci il progetto: ti rispondiamo entro 24 ore.'}
          </p>

          <div class="mt-12 space-y-6">
            <a href={`mailto:${globalSettings.contact?.email}`} class="flex items-center gap-4 group" data-cursor="scrivici">
              <span class="contact-icon shrink-0"><Mail class="w-5 h-5" strokeWidth={1.5} /></span>
              <span>
                <span class="mono-label text-white/60 block">Email</span>
                <span class="h-display text-xl text-[var(--paper)] group-hover:text-white transition-colors">{globalSettings.contact?.email}</span>
              </span>
            </a>
            <a href={`tel:${(globalSettings.contact?.phone || '').replace(/\s/g, '')}`} class="flex items-center gap-4 group" data-cursor="chiamaci">
              <span class="contact-icon shrink-0"><Phone class="w-5 h-5" strokeWidth={1.5} /></span>
              <span>
                <span class="mono-label text-white/60 block">Telefono</span>
                <span class="h-display text-xl text-[var(--paper)] group-hover:text-white transition-colors">{globalSettings.contact?.phone}</span>
              </span>
            </a>
          </div>

          <!-- Sedi -->
          <div class="mt-14 pt-8 border-t border-white/15">
            <p class="mono-label text-white/60 mb-6">— Sedi</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {locations.map((loc: any) => (
                <div class="location-card">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="h-display text-2xl text-[var(--paper)]">{loc.city}</span>
                    <span class="mono-label text-white/60">{loc.tag}</span>
                  </div>
                  <p class="text-white/75 mt-2">{loc.address}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 reveal-right">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

</Layout>
