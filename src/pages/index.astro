---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceIcons from '../components/ServiceIcons.astro';
import { ArrowDown, Instagram, Facebook, Phone, Mail, MessageCircle, Star } from 'lucide-astro';
import { cleanPhoneHref, whatsappHref } from '../lib/contact';

import homepage from '../../content/pages/homepage.json';
import globalSettings from '../../content/settings/global.json';

// Portfolio JSON (uno per video, generati da media/video)
const portfolioFiles = import.meta.glob<{ default: any }>(
  '/content/portfolio/*.json',
  { eager: true }
);

// Optional poster images (se l'editor ne carica uno)
const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/**/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
);

// Team photos (optional)
const teamImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/team/**/*.{png,jpg,jpeg,gif,webp}',
  { eager: true }
);

const categoryLabels: Record<string, string> = {
  social: 'Social Media',
  video: 'Video',
  campagna: 'Campagna',
  branding: 'Branding',
  contenuto: 'Contenuto',
  shooting: 'Shooting',
};

const portfolio = Object.entries(portfolioFiles)
  .map(([filePath, mod]) => {
    const slug = filePath.split('/').pop()?.replace('.json', '') || '';
    const d = mod.default;
    const titleData = d.title;
    const displayTitle = typeof titleData === 'object' ? titleData.name : titleData;
    const poster = d.poster ? portfolioImages[d.poster]?.default ?? null : null;
    return {
      slug,
      brand: d.brand || `Brand ${slug}`,
      videoSrc: d.videoSrc || '',
      poster,
      description: d.description || '',
      category: d.category || 'social',
      categoryLabel: categoryLabels[d.category] || 'Social Media',
      gridSize: d.gridSize || 'regular',
      order: d.order ?? 0,
      featured: d.featured !== false,
      displayTitle,
    };
  })
  .filter((p) => p.featured && p.videoSrc)
  .sort((a, b) => a.order - b.order);

// ---------- Homepage content (tutto editabile via Keystatic) ----------
const H: any = homepage;

// Sezione problema (immedesimazione)
const problem = {
  title: H.problem?.title || "Nel 2026 l'attenzione\nè la valuta più rara che esista.",
  body:
    H.problem?.body ||
    'Il tuo cliente ideale scorre centinaia di contenuti al giorno e decide in una frazione di secondo cosa merita un secondo sguardo. In questo rumore, un brand che non si fa notare semplicemente non esiste.',
  points:
    H.problem?.points ?? [
      'Pubblichi con costanza, ma i numeri restano piatti.',
      'I tuoi contenuti non raccontano quanto vali davvero.',
      'Competitor meno bravi di te sembrano ovunque. Tu, quasi invisibile.',
    ],
  turn:
    H.problem?.turn ||
    'Non ti serve più budget. Ti serve diventare impossibile da ignorare.',
  ctaLabel: H.problem?.ctaLabel || 'Parliamone',
  ctaHref: H.problem?.ctaHref || '#contatti',
};

// KPI di credibilità (mostrati nella sezione recensioni/proof)
const kpis = H.manifesto?.kpis ?? [];

const servicesList = H.servicesList ?? [];
const clients: string[] = H.clients ?? [];
const locations = H.locations ?? [];
const reviews = H.reviews ?? [];
const reviewsAgg = {
  rating: H.reviewsSection?.rating || '5,0',
  count: H.reviewsSection?.count || 159,
};
const marqueeText = H.marquee?.text || 'REAL GOES VIRAL';

// Team con foto opzionale
const team = (H.team ?? []).map((m: any) => {
  const photoModule = m.photo ? teamImages[m.photo] : null;
  return {
    ...m,
    photo: photoModule?.default ?? null,
  };
});

const mapsUrl = (loc: { city?: string; address?: string; mapsUrl?: string }) => {
  if (loc.mapsUrl) return loc.mapsUrl;
  const q = [loc.address, loc.city].filter(Boolean).join(', ');
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
};

// WhatsApp
const whatsappRaw = (globalSettings as any).whatsapp?.number || '';
const whatsappMessage = (globalSettings as any).whatsapp?.defaultMessage || '';
const whatsappUrl = whatsappHref(whatsappRaw, whatsappMessage);
const showWhatsapp = H.contact?.showWhatsapp !== false && Boolean(whatsappUrl);
const locationPhone = (loc: any) => loc.phone || globalSettings.contact?.phone || '';
const locationWhatsappUrl = (loc: any) =>
  whatsappHref(loc.whatsappNumber || whatsappRaw, loc.whatsappMessage || whatsappMessage);

// Google Reviews URL (fallback)
const googleReviewsUrl = (globalSettings as any).social?.googleReviewsUrl || '';

// ---------- Articoli dalla collection Keystatic ----------
const dateFormatter = new Intl.DateTimeFormat('it-IT', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const allArticles = await getCollection('articles');
const articles = allArticles
  .filter((a) => a.data.featured !== false)
  .sort((a, b) => {
    const ord = (a.data.order ?? 999) - (b.data.order ?? 999);
    if (ord !== 0) return ord;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3)
  .map((a) => ({
    tag: a.data.tag,
    title: a.data.title,
    date: dateFormatter.format(a.data.date),
    href: `articoli/${a.id}`,
  }));

const BASE = import.meta.env.BASE_URL;
const link = (path: string) => {
  if (!path) return BASE;
  if (path.startsWith('http://') || path.startsWith('https://') || path.startsWith('mailto:') || path.startsWith('tel:')) return path;
  if (path.startsWith('#')) return path;
  return BASE + path.replace(/^\//, '');
};

// ---------- Hero: parola 3D + definizione con keyword evidenziate ----------
const heroWord: string = H.hero?.word || 'VIRALITÀ';
const heroSyllables: string = H.hero?.syllables || 'vi·ra·li·tà';
const heroWordTag: string = H.hero?.wordTag || 's.f.';
const heroDefinition: string =
  H.hero?.definition ||
  "La viralità è la capacità di un contenuto o di un'informazione di diffondersi in modo estremamente rapido, capillare e incontrollato sul web, grazie alla condivisione a catena da parte degli utenti.";
const heroKeywords: string[] = (H.hero?.definitionKeywords ||
  'estremamente rapido, capillare, incontrollato, condivisione a catena')
  .split(',')
  .map((k: string) => k.trim())
  .filter(Boolean);
const heroDefinitionSource: string = H.hero?.definitionSource || 'Accademia della Crusca';
const heroPunchline: string = H.hero?.punchline || 'Noi la progettiamo ogni giorno, per brand come il tuo.';

const escapeHtml = (s: string) =>
  s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

// Evidenzia la prima occorrenza di ogni keyword nella definizione (case-insensitive)
const heroDefinitionHtml = heroKeywords.reduce((html, kw) => {
  const pattern = escapeHtml(kw).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return html.replace(new RegExp(`(${pattern})`, 'i'), '<mark class="kw">$1</mark>');
}, escapeHtml(heroDefinition));

// Livelli eco dietro la parola (profondità 3D crescente)
const heroEchoes = [1, 2, 3, 4, 5];
---

<Layout title={homepage.seo.title} description={homepage.seo.description} >

    <!-- =======================================================================
       HERO — minimale
       ======================================================================= -->
  <section id="home" class="min-h-screen flex flex-col justify-between pt-28 pb-10 md:pt-36" style="background: #DBEAFE;">
    <div class="container-custom flex-1 flex flex-col">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-auto">
        <p class="mono-label text-[var(--muted)]">
          {H.hero?.badge || '01 / HOMEPAGE'}
        </p>
        <p class="mono-label text-[var(--muted)] hidden md:block text-right whitespace-pre-line">
          {H.hero?.location || 'BOLOGNA · MODENA — IT\nMOTOR VALLEY'}
        </p>
      </div>
      <div class="my-auto py-10 md:py-16">
        <h1 class="h-display text-[clamp(3rem,13vw,11rem)] leading-[0.9]">
          <span class="line-reveal block" style="--line-delay:1.5s"><span>{H.hero?.titleLine1 || 'REAL'}</span></span>
          <span class="line-reveal block" style="--line-delay:1.6s"><span>{H.hero?.titleLine2 || 'GOES'}</span></span>
          <span class="line-reveal block" style="--line-delay:1.7s">
            <span>{H.hero?.titleLine3 || 'VIRAL'}<span class="inline-block align-top text-[var(--electric)]">.</span></span>
          </span>
        </h1>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-end mt-auto">
        <p class="md:col-span-5 quote-big text-[var(--ink)]">
          {H.hero?.tagline || 'Agenzia di comunicazione & marketing.'}
        </p>
        <div class="md:col-span-4">
          <a href={H.hero?.ctaHref || '#contatti'} class="btn-primary magnetic-btn" data-cursor="prenota">
            {H.hero?.ctaLabel || 'Prenota una Call'} <span class="btn-arrow">↗</span>
          </a>
        </div>
        <a href={H.hero?.scrollHref || '#manifesto'} class="md:col-span-3 flex items-center justify-start md:justify-end gap-3 text-[var(--muted)] hover:text-[var(--ink)] transition-colors" aria-label="Scorri per esplorare">
          <span class="mono-label">{H.hero?.scrollLabel || 'Scroll'}</span>
          <ArrowDown class="w-4 h-4 animate-bounce" />
        </a>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee section-dark">
    <div class="marquee-track">
      <span>
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
      </span>
      <span aria-hidden="true">
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
        {marqueeText} <span class="dot"></span>
      </span>
    </div>
  </div>

  <!-- =======================================================================
       PROBLEMA — il cliente deve immedesimarsi subito
       ======================================================================= -->
  <section id="problema" class="section">
    <div class="container-custom">
      <div class="max-w-5xl">
        <h2 class="section-title whitespace-pre-line reveal">
          {problem.title}
        </h2>
      </div>

      <ul class="problem-list mt-20 stagger-children">
        {problem.points.map((p: string) => (
          <li class="problem-item">
            <span class="problem-x" aria-hidden="true">✕</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>

      <div class="problem-turn-row mt-16 reveal">
        <p class="problem-turn">
          {problem.turn}
        </p>
        {problem.ctaLabel && (
          <a
            href={problem.ctaHref || '#contatti'}
            class="btn-rainbow shrink-0"
            data-cursor="parliamone"
            aria-label={problem.ctaLabel}
          >
            <span class="btn-rainbow-inner">
              {problem.ctaLabel}
              <span class="btn-rainbow-arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       SERVIZI — con icone animate
       ======================================================================= -->
  <section id="servizi" class="section">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12">
        <div class="lg:col-span-5 reveal-left">
          <h2 class="section-title">{H.servicesSection?.title || 'Quello che facciamo, ogni giorno.'}</h2>
        </div>
        <div class="lg:col-span-7 reveal">
          <p class="quote-big scrub-text text-[var(--ink)] whitespace-pre-line">
            {H.servicesSection?.intro || 'Un reparto marketing completo. Strategia, contenuti, performance.\nNessun pacchetto preconfezionato: solo quello che serve al tuo brand.'}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-t border-[var(--hairline)] stagger-children">
        {servicesList.map((s: any) => (
          <a href="#contatti" class="service-card" data-cursor="richiedi">
            <div class="flex items-baseline justify-between gap-4">
              <span class="mono-label text-[var(--muted)]">{s.num}</span>
              <span class="sv-arrow mono" aria-hidden="true">↗</span>
            </div>
            <div class="sv-head mt-4 flex items-start gap-4">
              {s.icon && s.icon !== 'none' && (
                <span class="sv-icon-wrap text-[var(--ink)]">
                  <ServiceIcons name={s.icon} />
                </span>
              )}
              <h3 class="sv-title">{s.title}</h3>
            </div>
            <p class="text-[var(--muted)] mt-3 max-w-md">{s.desc}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="sv-bullets mt-6">
                {s.bullets.map((b: string) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       PORTFOLIO — griglia compatta con video hover
       ======================================================================= -->
  <section id="portfolio" class="section-tight section-dark noise-overlay">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <h2 class="section-title max-w-3xl">
            {H.portfolioSection?.title || 'I lavori migliori, cliente per cliente.'}
          </h2>
        </div>
        <a href={H.portfolioSection?.ctaHref || '#contatti'} class="btn-outline" data-cursor="scrivici">
          {H.portfolioSection?.ctaLabel || 'Il tuo prossimo'} <span class="btn-arrow">↗</span>
        </a>
      </div>

      <div class="pf-dot-grid" id="portfolio-grid">
        {portfolio.map((item, index) => (
          <button
            type="button"
            class={`portfolio-card pf-card pf-${item.gridSize}`}
            data-index={index}
            data-video={item.videoSrc}
            data-cursor="apri"
            aria-label={`Apri ${item.brand}`}
          >
            <div class="pf-media">
              {item.poster && (
                <Image
                  src={item.poster}
                  alt={item.brand}
                  class="pf-poster"
                  loading="lazy"
                  width={360}
                  height={450}
                />
              )}
              <video
                class="pf-video"
                data-src={item.videoSrc}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
              <span class="pf-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><polygon points="7,5 19,12 7,19"/></svg>
              </span>
            </div>
            <div class="meta">
              <div>
                <span class="tag">{item.categoryLabel}</span>
                <span class="title block mt-1">{item.brand}</span>
              </div>
              <span class="tag">↗</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Video Lightbox -->
  <div id="video-lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="lightbox-overlay"></div>
    <button type="button" class="lightbox-close" aria-label="Chiudi">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="button" class="lightbox-nav lightbox-prev" aria-label="Video precedente">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button type="button" class="lightbox-nav lightbox-next" aria-label="Video successivo">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
    <div class="lightbox-content">
      <video id="lightbox-video" class="lightbox-video" controls playsinline preload="metadata"></video>
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
    <div class="lightbox-counter">
      <span id="lightbox-current">1</span> / <span id="lightbox-total">1</span>
    </div>
  </div>

  <script is:inline define:vars={{ portfolioData: portfolio.map((p) => ({ video: p.videoSrc, title: p.brand })) }}>
    const allCards = [...document.querySelectorAll('#portfolio-grid .pf-card')];

    // -------- Hover-to-play on the compact dot grid --------
    const portfolioCards = allCards;
    const isCoarse =
      window.matchMedia('(hover: none)').matches ||
      window.matchMedia('(pointer: coarse)').matches ||
      (window.navigator?.maxTouchPoints || 0) > 0 ||
      /Android|iPhone|iPad|iPod|Mobile/i.test(window.navigator?.userAgent || '');

    if (isCoarse) {
      portfolioCards.forEach((card) => {
        const video = card.querySelector('video.pf-video');
        if (video) video.remove();
      });
    }

    // Lazy-load a video's src only when about to play (prevents pre-loading
    // every video on page load, which crashes mobile GPU/memory).
    function loadVideoSrc(v) {
      if (!v.src && v.dataset.src) {
        v.src = v.dataset.src;
        v.load();
      }
    }

    portfolioCards.forEach((card) => {
      const video = card.querySelector('video');
      if (!video) return;
      video.addEventListener('loadeddata', () => card.classList.add('is-video-ready'));
      video.addEventListener('canplay', () => card.classList.add('is-video-ready'));
      video.addEventListener('error', () => card.classList.remove('is-video-ready'));

      const play = () => {
        try {
          loadVideoSrc(video);
          video.currentTime = 0;
          const p = video.play();
          if (p && typeof p.catch === 'function') p.catch(() => {});
        } catch (_) {}
      };
      const stop = () => {
        try { video.pause(); video.currentTime = 0; } catch (_) {}
      };

      if (!isCoarse) {
        card.addEventListener('mouseenter', play);
        card.addEventListener('mouseleave', stop);
        card.addEventListener('focus', play);
        card.addEventListener('blur', stop);
      }
    });

    // On touch devices, avoid viewport autoplay entirely. Cards open the
    // lightbox on tap, which keeps mobile scrolling stable and prevents
    // scroll-time decoding of many MP4s.

    // -------- Lightbox (video) --------
    const lb = document.getElementById('video-lightbox');
    const lbVideo = document.getElementById('lightbox-video');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbCurr = document.getElementById('lightbox-current');
    const lbTotal = document.getElementById('lightbox-total');
    let currentIndex = 0;
    const items = portfolioData;

    function openLb(i) {
      currentIndex = i;
      updateLb();
      lb.classList.add('active');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeLb() {
      lb.classList.remove('active');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      try { lbVideo.pause(); } catch (_) {}
      lbVideo.removeAttribute('src');
      try { lbVideo.load(); } catch (_) {}
    }
    function updateLb() {
      const it = items[currentIndex];
      try { lbVideo.pause(); } catch (_) {}
      lbVideo.src = it.video;
      try { lbVideo.load(); } catch (_) {}
      lbCaption.textContent = it.title;
      lbCurr.textContent = currentIndex + 1;
      lbTotal.textContent = items.length;
      if (isCoarse) return;
      try {
        const p = lbVideo.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      } catch (_) {}
    }
    const next = () => { currentIndex = (currentIndex + 1) % items.length; updateLb(); };
    const prev = () => { currentIndex = (currentIndex - 1 + items.length) % items.length; updateLb(); };

    portfolioCards.forEach((card) => {
      card.addEventListener('click', () => {
        const i = parseInt(card.dataset.index, 10);
        openLb(i);
      });
    });
    document.querySelector('.lightbox-close').addEventListener('click', closeLb);
    document.querySelector('.lightbox-overlay').addEventListener('click', closeLb);
    document.querySelector('.lightbox-next').addEventListener('click', next);
    document.querySelector('.lightbox-prev').addEventListener('click', prev);
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('active')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });

    let tsx = 0, tex = 0;
    lb.addEventListener('touchstart', (e) => { tsx = e.changedTouches[0].screenX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      tex = e.changedTouches[0].screenX;
      const d = tsx - tex;
      if (Math.abs(d) > 50) { if (d > 0) next(); else prev(); }
    }, { passive: true });
  </script>

  <!-- =======================================================================
       RECENSIONI — proof reale da Google (media 5,0 su 159 recensioni)
       ======================================================================= -->
  <section id="recensioni" class="section">
    <div class="container-custom">
      <div class="reviews-proof">
        <div class="reviews-rating reveal-left">
          <div class="rating-badge">
            <span class="rating-num">{reviewsAgg.rating}</span>
            <span class="rating-stars" role="img" aria-label={`${reviewsAgg.rating} stelle su 5`}>
              <Star class="w-5 h-5" fill="currentColor" strokeWidth={0} />
              <Star class="w-5 h-5" fill="currentColor" strokeWidth={0} />
              <Star class="w-5 h-5" fill="currentColor" strokeWidth={0} />
              <Star class="w-5 h-5" fill="currentColor" strokeWidth={0} />
              <Star class="w-5 h-5" fill="currentColor" strokeWidth={0} />
            </span>
            <span class="rating-google">su Google</span>
          </div>
          <p class="rating-meta">
            Media reale su <strong>{reviewsAgg.count} recensioni</strong> verificate.
          </p>
          <h2 class="section-title mt-8 max-w-2xl whitespace-pre-line">
            {H.reviewsSection?.title || 'Non lo diciamo noi.\nLo dicono i clienti, su Google.'}
          </h2>
          {googleReviewsUrl && (
            <a
              href={googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-viral mt-10"
              data-cursor="leggi su google"
            >
              Leggi le recensioni su Google <span class="btn-arrow">↗</span>
            </a>
          )}
        </div>

        {kpis.length > 0 && (
          <div class="reviews-kpis stagger-children">
            {kpis.map((k: any) => (
              <div class="kpi">
                <span class="num mono-num" data-counter={k.num} data-suffix={k.suffix}>0{k.suffix}</span>
                <span class="label">{k.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {reviews.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border-t border-b border-[var(--hairline)] stagger-children mt-16">
        {reviews.map((r: any) => {
          const href = r.googleUrl || googleReviewsUrl;
          return href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="leggi su google"
              class="feature-card review-card border-0 md:border-r md:border-[var(--hairline)] last:md:border-r-0 h-full flex flex-col justify-between gap-8 min-h-[280px]"
            >
              <div>
                <div class="flex gap-1 mb-4 text-[var(--electric)]">
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                </div>
                <p class="quote-big">"{r.quote}"</p>
              </div>
              <div class="flex items-end justify-between gap-4">
                <div>
                  <p class="mono-label text-[var(--ink)]">{r.author}</p>
                  <p class="mono-label text-[var(--muted)] mt-1">{r.role}</p>
                </div>
                <span class="mono-label text-[var(--muted)]">Google ↗</span>
              </div>
            </a>
          ) : (
            <div class="feature-card review-card border-0 md:border-r md:border-[var(--hairline)] last:md:border-r-0 h-full flex flex-col justify-between gap-8 min-h-[280px]">
              <div>
                <div class="flex gap-1 mb-4 text-[var(--electric)]">
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                  <Star class="w-4 h-4" fill="currentColor" strokeWidth={0} />
                </div>
                <p class="quote-big">"{r.quote}"</p>
              </div>
              <div>
                <p class="mono-label text-[var(--ink)]">{r.author}</p>
                <p class="mono-label text-[var(--muted)] mt-1">{r.role}</p>
              </div>
            </div>
          );
        })}
      </div>
      )}
    </div>
  </section>

  <!-- =======================================================================
       TEAM
       ======================================================================= -->
  <section id="team" class="section section-dark noise-overlay">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <h2 class="section-title max-w-3xl">
            {H.teamSection?.title || 'Persone vere dietro ogni post.'}
          </h2>
        </div>
        <p class="mono-label text-white/60 max-w-xs" data-parallax="0.18">
          {H.teamSection?.subtitle || 'Un team piccolo, selezionato, ossessionato dal risultato.'}
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" data-team-grid>
        {team.map((m: any) => (
          <div class="portfolio-card !aspect-[3/4] bg-[var(--ink-soft)]" data-tilt>
            {m.photo ? (
              <Image
                src={m.photo}
                alt={m.name}
                width={500}
                height={667}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="h-display text-[clamp(3rem,10vw,6rem)] text-white/20 select-none">{m.initials}</span>
              </div>
            )}
            <div class="meta" style="transform: translateY(0); opacity: 1;">
              <div>
                <span class="tag">{m.role}</span>
                <span class="title block mt-1">{m.name}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       ARTICOLI
       ======================================================================= -->
  <section id="articoli" class="section">
    <div class="container-custom">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="reveal-left">
          <h2 class="section-title max-w-3xl">{H.articlesSection?.title || 'Interviste & approfondimenti.'}</h2>
        </div>
        <a href={H.articlesSection?.ctaHref || '#contatti'} class="btn-outline" data-cursor="scrivici">
          {H.articlesSection?.ctaLabel || 'Suggeriscine uno'} <span class="btn-arrow">↗</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        {articles.map((a: any) => (
          <a href={link(a.href || 'articoli')} class="feature-card group block" data-cursor="leggi">
            <p class="mono-label text-[var(--electric)] mb-6">{a.tag}</p>
            <h3 class="text-2xl md:text-3xl leading-tight mb-8">{a.title}</h3>
            <div class="flex items-center justify-between border-t border-[var(--hairline)] pt-4">
              <span class="mono-label text-[var(--muted)]">{a.date}</span>
              <span class="mono-label">Leggi ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =======================================================================
       SOCIAL (compact)
       ======================================================================= -->
  <section id="social" class="section-tight">
    <div class="container-custom">
      <div class="flex flex-wrap items-center justify-between gap-6 border-y border-[var(--hairline)] py-8">
        <div>
          <p class="eyebrow">Seguici</p>
          <p class="h-display text-2xl md:text-3xl mt-2">{H.social?.title || 'Restiamo connessi'}</p>
        </div>
        <div class="flex items-center gap-3">
          {globalSettings.social?.instagram && (
            <a
              href={globalSettings.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
              data-cursor="instagram"
              aria-label="Instagram"
            >
              <Instagram class="w-4 h-4" strokeWidth={1.5} /> Instagram
            </a>
          )}
          {globalSettings.social?.facebook && (
            <a
              href={globalSettings.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
              data-cursor="facebook"
              aria-label="Facebook"
            >
              <Facebook class="w-4 h-4" strokeWidth={1.5} /> Facebook
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       CONTATTI — Prenota una call, WhatsApp, telefono, email + form
       ======================================================================= -->
  <section id="contatti" class="section cta-section noise-overlay">
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-6 reveal-left">
          <h2 class="section-title text-[var(--paper)]">
            {H.contact?.title || 'Prenota una call.'}
          </h2>
          <p class="quote-big scrub-text mt-6 text-white/85 max-w-xl">
            {H.contact?.description || 'Raccontaci il progetto: ti rispondiamo entro 24 ore.'}
          </p>

          <!-- Quick contact buttons: WhatsApp + Phone -->
          <div class="contact-quick mt-10">
            {showWhatsapp && (
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-btn contact-btn-wa"
                data-cursor="whatsapp"
              >
                <MessageCircle class="w-5 h-5" strokeWidth={1.6} />
                <span>
                  <span class="cb-label">{H.contact?.whatsappLabel || 'Scrivici su WhatsApp'}</span>
                  <span class="cb-sub">Risposta in poche ore</span>
                </span>
                <span class="cb-arrow" aria-hidden="true">↗</span>
              </a>
            )}
            {globalSettings.contact?.phone && (
              <a
                href={`tel:${cleanPhoneHref(globalSettings.contact?.phone)}`}
                class="contact-btn contact-btn-phone"
                data-cursor="chiamaci"
              >
                <Phone class="w-5 h-5" strokeWidth={1.6} />
                <span>
                  <span class="cb-label">{H.contact?.phoneLabel || 'Chiamaci ora'}</span>
                  <span class="cb-sub">{globalSettings.contact.phone}</span>
                </span>
                <span class="cb-arrow" aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <div class="mt-10 pt-8 border-t border-white/15 space-y-6">
            <a href={`mailto:${globalSettings.contact?.email}`} class="flex items-center gap-4 group" data-cursor="scrivici">
              <span class="contact-icon shrink-0"><Mail class="w-5 h-5" strokeWidth={1.5} /></span>
              <span>
                <span class="mono-label text-white/60 block">Email</span>
                <span class="h-display text-xl text-[var(--paper)] group-hover:text-white transition-colors">{globalSettings.contact?.email}</span>
              </span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 reveal-right">
          <ContactForm />
        </div>

        <!-- Sedi -->
        <div class="lg:col-span-12 mt-4 pt-8 border-t border-white/15">
          <p class="mono-label text-white/60 mb-6">— Sedi</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {locations.map((loc: any) => (
              <div class="location-card">
                <a
                  href={mapsUrl(loc)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block"
                  data-cursor="apri mappa"
                  aria-label={`Apri ${loc.city ?? loc.address} su Google Maps`}
                >
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="h-display text-2xl text-[var(--paper)] group-hover:text-white transition-colors">{loc.city}</span>
                    <span class="mono-label text-white/60">{loc.tag}</span>
                  </div>
                  {loc.address && (
                    <p class="text-white/75 mt-2 group-hover:text-white transition-colors">{loc.address}</p>
                  )}
                </a>
                <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4 text-sm">
                  {locationPhone(loc) && (
                    <a
                      href={`tel:${cleanPhoneHref(locationPhone(loc))}`}
                      class="inline-flex items-center gap-1.5 whitespace-nowrap text-white/70 hover:text-[var(--electric)] transition-colors"
                      aria-label={`Chiama la sede di ${loc.city}`}
                    >
                      <Phone class="w-4 h-4 shrink-0" strokeWidth={1.7} />
                      <span>{locationPhone(loc)}</span>
                    </a>
                  )}
                  {locationWhatsappUrl(loc) && (
                    <a
                      href={locationWhatsappUrl(loc)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 whitespace-nowrap text-white/70 hover:text-[var(--electric)] transition-colors"
                      aria-label={`Scrivi alla sede di ${loc.city} su WhatsApp`}
                    >
                      <MessageCircle class="w-4 h-4 shrink-0" strokeWidth={1.7} />
                      <span>WhatsApp</span>
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


<script>
  // Tracciamento WhatsApp
  document.querySelectorAll('a[data-cursor="whatsapp"]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'click_whatsapp', {
          event_category: 'Lead',
          event_label: 'WhatsApp contact',
        });
      }
    });
  });

  // Tracciamento telefono
 document.querySelectorAll('a[href^="tel:"]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'click_phone', {
          event_category: 'Lead',
          event_label: 'Phone contact',
        });
      }
    });
  });
</script>
</Layout>
