---
import Layout from '../layouts/Layout.astro';
import globalSettings from '../../content/settings/global.json';
const email = globalSettings.contact?.email || 'info@viralagency.it';
const phone = globalSettings.contact?.phone || '+39 371 376 7488';
const BASE = import.meta.env.BASE_URL;
const services = [
  { title: 'Strategia di Marketing', desc: "Analisi del mercato modenese, definizione del posizionamento, piano d'azione con obiettivi misurabili." },
  { title: 'Performance Advertising', desc: 'Campagne Meta Ads, Google Ads e TikTok Ads ottimizzate per il costo per acquisizione del tuo settore.' },
  { title: 'Funnel & Lead Generation', desc: 'Costruiamo il percorso che trasforma gli sconosciuti in clienti. Landing page, email automation, CRM.' },
  { title: 'SEO & Contenuti', desc: 'Visibilità organica a lungo termine: contenuti ottimizzati, link building locale, presenza nei risultati di Modena.' },
  { title: 'Email Marketing', desc: "Newsletter e automation che mantengono caldo il rapporto con i tuoi clienti modenesi tra un acquisto e l'altro." },
  { title: 'Analitiche & KPI', desc: 'Dashboard personalizzata con i dati che contano davvero. Decisioni basate su numeri reali, non su sensazioni.' },
];
const schema = JSON.stringify({
  "@context":"https://schema.org","@graph":[
    {"@type":"LocalBusiness","@id":"https://viralagency.it/#business","name":"Viral Digital Agency | Agenzia di Marketing","url":"https://viralagency.it","telephone":"+393713767488","email":"info@viralagency.it","hasMap":"https://maps.google.com/?kgmid=/g/11m75qc3vq","address":[{"@type":"PostalAddress","streetAddress":"Piazza Tintori 27","addressLocality":"Bastiglia","addressRegion":"MO","postalCode":"41033","addressCountry":"IT"},{"@type":"PostalAddress","streetAddress":"V.le Pietro Pietramellara, 33","addressLocality":"Bologna","addressRegion":"BO","postalCode":"40121","addressCountry":"IT"}],"areaServed":["Modena","Bastiglia","Emilia-Romagna"],"priceRange":"€€"},
    {"@type":"Service","name":"Marketing Digitale Modena","serviceType":"Digital Marketing","provider":{"@id":"https://viralagency.it/#business"},"areaServed":"Modena","description":"Strategie di marketing digitale, advertising, funnel e lead generation per aziende di Modena e provincia."}
  ]
});
---
<Layout title="Agenzia di Marketing Modena | Viral Digital Agency" description="Agenzia di marketing digitale a Modena. Strategie, funnel, advertising e analytics per far crescere il tuo business nel mercato locale e nazionale. Studio a Bastiglia (MO).">
  <div class="pt-28 md:pt-40">
    <section class="section">
      <div class="container-custom">
        <p class="eyebrow reveal">Marketing Digitale · Modena</p>
        <h1 class="h-display text-[clamp(2.5rem,6.5vw,5.5rem)] leading-[0.92] mt-3 max-w-4xl reveal">
          Agenzia di Marketing<br />a <em class="not-italic text-[var(--electric)]">Modena</em>
        </h1>
        <p class="text-[1.125rem] text-[var(--muted)] max-w-2xl mt-6 leading-relaxed reveal">
          Aiutiamo le aziende modenesi a crescere online con strategie di marketing digitale costruite sui dati e sull'esperienza nel territorio. Dalla Motor Valley all'Italia intera.
        </p>
        <div class="flex flex-wrap gap-4 mt-10 reveal">
          <a href={`${BASE}#contatti`} class="btn-primary magnetic-btn" data-cursor="parliamo">Richiedi una consulenza</a>
          <a href={`tel:${phone.replace(/\s/g,'')}`} class="btn-outline">{phone}</a>
        </div>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container-custom">
        <p class="eyebrow reveal">I nostri servizi</p>
        <h2 class="section-title mt-3 max-w-3xl">Marketing integrato per le PMI di Modena e provincia.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-12">
          {services.map((s) => (
            <div class="reveal border border-white/10 p-6 rounded-sm hover:border-[var(--electric)] transition-colors">
              <h3 class="font-semibold text-[var(--paper)] mb-2">{s.title}</h3>
              <p class="text-sm text-white/70 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container-custom">
        <p class="eyebrow reveal">Il nostro approccio</p>
        <h2 class="section-title mt-3 max-w-3xl">Marketing che si misura. Risultati che si vedono.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 max-w-4xl">
          <p class="text-[var(--muted)] leading-relaxed reveal">L'Emilia-Romagna è una delle regioni più competitive d'Italia per le PMI manifatturiere, il food e il terziario avanzato. Le aziende di Modena devono competere localmente ma anche farsi trovare dai clienti di tutta Italia. Costruiamo strategie che funzionano a entrambe le scale.</p>
          <p class="text-[var(--muted)] leading-relaxed reveal">Lavoriamo sempre con obiettivi chiari e misurabili: lead generati, costo per acquisizione, ritorno sull'investimento. Non promettiamo visti o follower generici — promettiamo clienti reali e fatturato. Poi ci rendiamo conto insieme se lo stiamo raggiungendo.</p>
        </div>
      </div>
    </section>
    <section class="section section-dark">
      <div class="container-custom">
        <p class="eyebrow reveal">Dove siamo</p>
        <h2 class="section-title mt-3">Il nostro team è a Modena e a Bologna.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
          <div class="reveal">
            <p class="mono-label text-white/60 mb-4">Studio Creativo — Modena</p>
            <address class="not-italic space-y-1 text-[var(--paper)]">
              <strong class="block text-lg">Viral Digital Agency</strong>
              <span class="block text-white/80">Piazza Tintori 27</span>
              <span class="block text-white/80">Bastiglia (MO) – 41033</span>
              <a href={`tel:${phone.replace(/\s/g,'')}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors mt-4">{phone}</a>
              <a href={`mailto:${email}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors">{email}</a>
            </address>
            <a href="https://maps.google.com/?kgmid=/g/11m75qc3vq" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-5 text-sm text-[var(--electric)] hover:underline">Vedi su Google Maps ↗</a>
          </div>
          <div class="reveal">
            <p class="mono-label text-white/60 mb-4">Sede HQ — Bologna</p>
            <address class="not-italic space-y-1 text-[var(--paper)]">
              <strong class="block text-lg">Viral Digital Agency — HQ</strong>
              <span class="block text-white/80">V.le Pietro Pietramellara, 33</span>
              <span class="block text-white/80">40121 Bologna BO</span>
              <a href={`tel:${phone.replace(/\s/g,'')}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors mt-4">{phone}</a>
              <a href={`mailto:${email}`} class="block text-white/80 hover:text-[var(--electric)] transition-colors">{email}</a>
            </address>
          </div>
        </div>
      </div>
    </section>
    <section class="section cta-section noise-overlay">
      <div class="container-custom text-center">
        <p class="eyebrow reveal">Parti adesso</p>
        <h2 class="section-title mt-3 max-w-2xl mx-auto">Pronto a far crescere la tua azienda modenese?</h2>
        <p class="text-[var(--paper)]/80 max-w-xl mx-auto mt-4 leading-relaxed reveal">Prenota una consulenza gratuita. In 30 minuti capiamo insieme dove stai lasciando soldi sul tavolo e come recuperarli.</p>
        <div class="flex flex-wrap gap-4 justify-center mt-8 reveal">
          <a href={`${BASE}#contatti`} class="btn-primary magnetic-btn">Consulenza gratuita</a>
          <a href={`mailto:${email}`} class="btn-outline">{email}</a>
        </div>
      </div>
    </section>
  </div>
  <script is:inline type="application/ld+json" set:html={schema} />
</Layout>
