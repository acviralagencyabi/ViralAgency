---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

import settings from '../../content/settings/global.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// ────────────────────────────────────────────────────────────────────────────
// CUSTOM CURSOR TOGGLE
// Set to `false` to disable the custom cursor effect site-wide.
// Native cursor + no dot, in a single switch.
const CUSTOM_CURSOR = true;
// ────────────────────────────────────────────────────────────────────────────

const fullTitle = title
  ? `${title}${settings.seo?.titleSuffix || ''}`
  : settings.companyName;

const metaDescription = description || settings.seo?.defaultDescription || '';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImage = image || '/uploads/image.png';
const ogImageURL = new URL(ogImage, Astro.site);

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": settings.companyName,
  "description": metaDescription,
  "url": Astro.site?.toString(),
  "logo": ogImageURL.toString(),
  "image": ogImageURL.toString(),
  "telephone": settings.contact?.phone,
  "email": settings.contact?.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": settings.contact?.address,
    "addressLocality": "Bastiglia",
    "addressRegion": "MO",
    "postalCode": "41033",
    "addressCountry": "IT"
  },
  "sameAs": [settings.social?.facebook, settings.social?.instagram].filter(Boolean),
  "priceRange": "€€"
};

---

<!doctype html>
<html lang="it" data-cursor-fx={CUSTOM_CURSOR ? 'on' : 'off'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={settings.companyName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}favicon-192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}favicon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <!-- Page-load intro overlay (matrix scramble on black) -->
    <div class="intro-overlay" aria-hidden="true">
      <div class="intro-brand">
        <span class="intro-scramble" data-text="REAL GOES VIRAL">REAL GOES VIRAL</span><span class="dot">.</span>
      </div>
    </div>

    <!-- Custom cursor (toggle via CUSTOM_CURSOR constant above) -->
    {CUSTOM_CURSOR && (
      <div id="cursor-dot" class="cursor-dot" aria-hidden="true">
        <span class="label"></span>
      </div>
    )}

    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      // ---------- Split-flap reveal — intro wordmark (page-load) ----------
      // Each character flips through a short ordered sequence before landing,
      // left-to-right, mimicking a Solari/departures-board flip panel.
      {
        const el = document.querySelector<HTMLElement>('.intro-scramble');
        if (el) {
          const target = el.dataset.text || el.textContent || '';
          const FLAP    = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
          const FLIP_MS  = 90;  // duration of one flip animation (ms)
          const STEPS    = 5;   // cycling steps per char before settling
          const STAGGER  = 40;  // ms between each char starting

          // Build one <span class="flap-char"> per non-space char
          el.innerHTML = '';
          const chars: Array<{ span: HTMLSpanElement; to: string }> = [];
          for (const ch of target) {
            if (ch === ' ') {
              el.appendChild(document.createTextNode(' '));
            } else {
              const span = document.createElement('span');
              span.className = 'flap-char';
              // Initial display: a random char from the board
              span.textContent = FLAP[Math.floor(Math.random() * FLAP.length)];
              el.appendChild(span);
              chars.push({ span, to: ch });
            }
          }

          // One flip cycle: squish → change char → unsquish
          const flipTo = (span: HTMLSpanElement, ch: string) =>
            new Promise<void>((res) => {
              span.classList.remove('flipping');
              void span.offsetWidth; // force reflow to restart animation
              span.classList.add('flipping');
              setTimeout(() => { span.textContent = ch; }, FLIP_MS * 0.46);
              setTimeout(() => { span.classList.remove('flipping'); res(); }, FLIP_MS);
            });

          // Stagger each char, flip STEPS times through FLAP then land on target
          chars.forEach(({ span, to }, i) => {
            setTimeout(async () => {
              for (let s = 0; s < STEPS - 1; s++) {
                await flipTo(span, FLAP[Math.floor(Math.random() * FLAP.length)]);
              }
              await flipTo(span, to);
            }, i * STAGGER);
          });
        }
      }

      // ---------- Custom cursor (guarded by data-cursor-fx) ----------
      if (document.documentElement.dataset.cursorFx === 'on') {
        const cursor = document.getElementById('cursor-dot');
        const cursorLabel = cursor?.querySelector<HTMLSpanElement>('.label');

        if (cursor) {
          // No inertia: cursor follows the mouse 1:1.
          document.addEventListener('mousemove', (e) => {
            cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px) translate(-50%, -50%)`;
          });

          document.addEventListener('mouseleave', () => (cursor.style.opacity = '0'));
          document.addEventListener('mouseenter', () => (cursor.style.opacity = '1'));

          // Two hover levels:
          //  - `.is-labeled` + label text  → only on elements with `data-cursor="…"`
          //  - `.is-hover`                 → subtle enlargement, no label
          const hoverSelector =
            'a, button, [role="button"], .portfolio-card, .feature-card, .service-row, input, textarea';
          document.querySelectorAll<HTMLElement>(hoverSelector).forEach((el) => {
            el.addEventListener('mouseenter', () => {
              const raw = el.dataset.cursor;
              if (raw) {
                cursor.classList.remove('is-hover');
                cursor.classList.add('is-labeled');
                if (cursorLabel) cursorLabel.textContent = raw;
              } else {
                cursor.classList.remove('is-labeled');
                cursor.classList.add('is-hover');
                if (cursorLabel) cursorLabel.textContent = '';
              }
            });
            el.addEventListener('mouseleave', () => {
              cursor.classList.remove('is-hover', 'is-labeled');
              if (cursorLabel) cursorLabel.textContent = '';
            });
          });
        }
      }

      // ---------- Scroll reveal ----------
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('active');
        });
      }, { threshold: 0.15 });

      document
        .querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .stagger-children, .line-reveal')
        .forEach((el) => revealObserver.observe(el));

      // ---------- Click pixel burst ----------
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Only burst on interactive elements
        if (!target.closest('a, button, [role="button"], .portfolio-card, .service-row')) return;

        const burst = document.createElement('div');
        burst.className = 'click-burst';
        burst.style.left = e.clientX + 'px';
        burst.style.top = e.clientY + 'px';

        const variants = ['', 'alt', 'ink'];
        for (let i = 0; i < 14; i++) {
          const px = document.createElement('span');
          px.className = 'px ' + variants[i % 3];
          const angle = (Math.PI * 2 * i) / 14 + Math.random() * 0.4;
          const dist = 40 + Math.random() * 60;
          px.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
          px.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
          px.style.animationDelay = `${Math.random() * 0.05}s`;
          burst.appendChild(px);
        }

        document.body.appendChild(burst);
        setTimeout(() => burst.remove(), 900);
      });

      // ---------- Remove page-load intro after animation ----------
      setTimeout(() => {
        document.querySelector('.intro-overlay')?.remove();
      }, 2500);

      // ---------- Magnetic buttons ----------
      document.querySelectorAll<HTMLElement>('.magnetic-btn').forEach((btn) => {
        btn.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          btn.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0, 0)';
        });
      });

      // ---------- KPI counter ----------
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const from = 0;
          function step(now: number) {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            const val = from + (target - from) * eased;
            el.textContent = (Number.isInteger(target) ? Math.round(val).toString() : val.toFixed(1)) + suffix;
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
          counterObserver.unobserve(el);
        });
      }, { threshold: 0.5 });
      counters.forEach((c) => counterObserver.observe(c));

      // ---------- Lenis smooth scroll (team99-style inertia) ----------
      import('lenis').then(({ default: Lenis }) => {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced) return;

        const lenis = new Lenis({
          duration: 1.15,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          touchMultiplier: 1.4,
        });

        const rafLoop = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(rafLoop);
        };
        requestAnimationFrame(rafLoop);

        // Intercept anchor links → smooth scroll via Lenis
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (!href || href === '#') return;
            const target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            e.stopPropagation();
            lenis.scrollTo(target as HTMLElement, { offset: -60 });
          }, true);
        });
      });

      // ---------- Split-flap reveal — section titles + hero display ----------
      // Characters cycle through the board alphabet in order, left-to-right.
      // stagger = rAF frames between each char starting; steps = flips per char.
      {
        const BOARD = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

        const splitFlapRoot = (
          root: Element,
          stagger = 3,
          steps   = 5,
          onDone?: () => void
        ) => {
          type CharEntry = {
            to: string; skip: boolean;
            start: number; end: number; flapPos: number;
          };
          const items: Array<{ node: Text; queue: CharEntry[] }> = [];

          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          let n: Node | null;
          let charCount = 0;

          while ((n = walker.nextNode())) {
            const text = (n as Text).textContent || '';
            if (!text.trim()) continue;

            const queue: CharEntry[] = [...text].map((ch) => {
              if (/[\s\n\r.,!?—–\-:;'"()]/.test(ch)) {
                return { to: ch, skip: true, start: 0, end: 0, flapPos: 0 };
              }
              const start    = charCount * stagger;
              const end      = start + steps;
              const targetIdx = BOARD.indexOf(ch.toUpperCase());
              const flapPos   = targetIdx >= 0
                ? (targetIdx - steps + BOARD.length * 4) % BOARD.length
                : Math.floor(Math.random() * BOARD.length);
              charCount++;
              return { to: ch, skip: false, start, end, flapPos };
            });

            items.push({ node: n as Text, queue });
          }

          if (!items.length) { onDone?.(); return; }

          const maxFrame = items.reduce(
            (acc, { queue }) => Math.max(acc, ...queue.map((q) => q.end)), 0
          );

          items.forEach(({ node, queue }) => {
            node.textContent = queue.map((q) => q.skip ? q.to : BOARD[q.flapPos]).join('');
          });

          let frame = 0;
          const tick = () => {
            for (const { node, queue } of items) {
              let out = '';
              for (const q of queue) {
                if (q.skip)          { out += q.to; continue; }
                if (frame >= q.end)  { out += q.to; continue; }
                if (frame < q.start) { out += BOARD[q.flapPos]; continue; }
                out += BOARD[(q.flapPos + (frame - q.start)) % BOARD.length];
              }
              node.textContent = out;
            }
            if (frame >= maxFrame) { onDone?.(); return; }
            frame++;
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        // ── Hero h-display only: fire after intro overlay begins to fade ──────
        const heroEl = document.querySelector<HTMLElement>('[data-flap-hero]');
        if (heroEl) {
          setTimeout(() => {
            heroEl.style.opacity = '1';
            splitFlapRoot(heroEl, 6, 5);
          }, 1200);
        }
      }

      // ---------- Word-by-word reveal on section titles (scroll-triggered) ----
      // Each word slides up from behind its overflow:hidden container.
      // Pure CSS transition, no text mutation, works on all pages.
      {
        const wrapWords = (el: HTMLElement) => {
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes: Text[] = [];
          let n: Node | null;
          while ((n = walker.nextNode())) {
            if (((n as Text).textContent || '').trim()) nodes.push(n as Text);
          }
          let wi = 0;
          nodes.forEach((node) => {
            const parts = (node.textContent || '').split(/(\s+)/);
            const frag  = document.createDocumentFragment();
            parts.forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) {
                frag.appendChild(document.createTextNode(part));
              } else {
                const outer = document.createElement('span');
                outer.className = 'wr';
                const inner = document.createElement('span');
                inner.className = 'wr-i';
                inner.style.transitionDelay = `${wi * 0.07}s`;
                inner.textContent = part;
                outer.appendChild(inner);
                frag.appendChild(outer);
                wi++;
              }
            });
            node.parentNode?.replaceChild(frag, node);
          });
        };

        const io2 = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              wrapWords(el);
              requestAnimationFrame(() => el.classList.add('sf-active'));
              io2.unobserve(el);
            });
          },
          { threshold: 0.3 }
        );
        document.querySelectorAll<HTMLElement>('.section-title')
          .forEach((el) => io2.observe(el));
      }
    </script>
  </body>
</html>
